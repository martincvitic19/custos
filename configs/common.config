# Custos common package set (device-independent). Appended to a device
# config by custos/build.sh, then expanded with `make defconfig`.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-custos=y
CONFIG_PACKAGE_custos=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
# CRA Art. 13: CycloneDX SBOM next to the images
CONFIG_JSON_CYCLONEDX_SBOM=y
