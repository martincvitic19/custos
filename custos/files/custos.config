
config custos 'main'
	# Always enforced, for every device, and not configurable: the adult
	# content lists, SafeSearch on every engine and the bypass protection
	# (DoH/VPN/proxy list, Firefox canary domain, iCloud Private Relay).
	# Devices not listed below are always treated as 'child'.

config connection 'connection'
	# Custos' own address on the ISP router's network. Pick one outside
	# the ISP router's DHCP range (switch that DHCP server off anyway).
	option ipaddr '192.168.0.14/24'
	# The ISP router: it stays the gateway (router) of every device.
	option gateway '192.168.0.1'

config filtering 'filtering'
	# HaGeZi list ids, see /usr/share/custos/blocklists.json
	list blocklist 'pro'
	list blocklist 'tif.medium'
	list blocklist 'nsfw'
	# fake, popupads, native.tiktok, native.lgwebos and native.xiaomi are
	# left out: over 95% of their domains are already in 'pro'.
	list blocklist 'hoster'
	list blocklist 'dns-rebind-protection'
	list blocklist 'social'
	list blocklist 'nosafesearch'
	list blocklist 'native.samsung'
	list blocklist 'native.winoffice'
	list blocklist 'native.amazon'
	list blocklist 'native.apple'
	list blocklist 'native.huawei'
	# AdGuard Home blocked-service ids (apply to child devices)
	#list blocked_service 'tiktok'
	# Extra domains to block / always allow
	#list block_domain 'example.com'
	#list allow_domain 'school.example.org'

# Example device (managed from LuCI -> Custos -> Devices)
#config device
#	option name 'Kid tablet'
#	option mac '00:11:22:33:44:55'
#	option role 'child'	# or 'trusted': no blocked services
